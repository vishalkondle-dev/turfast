# Local development environment (copy to .env)
LOCAL_DB_URL=file:./local.db
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail API (logixsoft). Leave key empty in dev to print OTP to console instead of sending.
MAIL_API_URL=https://mail.logixsoft.in/send-email
MAIL_API_KEY=
MAIL_FROM_NAME=Turfast

# Cashfree (sandbox). Leave empty to use the simulated payment gateway.
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_ENV=sandbox
